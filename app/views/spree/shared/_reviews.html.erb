
  <div id="reviews">
    <% if Spree::Reviews::Config[:include_unapproved_reviews] == false and product.reviews.approved.count == 0 %>
      <p class="reviews-none"><%= Spree.t(:no_reviews_available) %></p>
    <% else %>
      <%= render 'spree/shared/rating', product: product, review: 0 %>
    
      <% @product.reviews.each do |review| %>
        <div class="review">
          <strong><%= review.user.try(:name) || review.user.try(:email) || "Anonymous" %></strong><br>
          <%= review.review %><br>
          <%= "⭐" * review.rating %>
        </div>
      <% end %>
    <% end %>
    <%= link_to Spree.t(:write_your_own_review), new_product_review_path(product), class: 'btn btn-primary mt-2', rel: 'nofollow', data: { turbo: false} %>

    <% unless Spree::Reviews::Config[:include_unapproved_reviews] == false and product.reviews.approved.count == 0 %>
      <%= Spree.t(:or) %>
      <%= link_to Spree.t(:read_all_reviews), product_reviews_path(product), class: 'btn btn-primary mt-2', rel: 'nofollow', data: { turbo: false} %>
    <% end %>
  </div>
